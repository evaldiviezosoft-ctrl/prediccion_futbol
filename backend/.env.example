APP_NAME=Football Predictor API
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API-Football: coloca aquí una clave nueva y mantenla solo en backend/.env.
API_FOOTBALL_KEY=REEMPLAZAR
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_DAILY_SOFT_LIMIT=90
API_DAILY_SAFETY_RESERVE=15
API_MAX_REQUESTS_PER_RUN=80
API_DELAY_SECONDS=7
API_REQUEST_TIMEOUT_SECONDS=25
API_RETRY_MAX_ATTEMPTS=3
API_RETRY_BASE_DELAY_SECONDS=1
API_RETRY_MAX_DELAY_SECONDS=30
API_TIMEZONE=America/Lima
UPCOMING_DAYS=30
COMPETITIONS_CONFIG_PATH=./app/config/competitions.yaml

# Supabase > Project Settings > API Keys. Usa una sb_secret_ nueva.
SUPABASE_URL=https://yrdtvgegicjvobaioxof.supabase.co
SUPABASE_SECRET_KEY=REEMPLAZAR_SOLO_BACKEND
# Compatibilidad temporal si el proyecto aún usa la clave JWT heredada:
# SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_SOLO_BACKEND

# Protege las rutas administrativas de sincronización.
ADMIN_TOKEN=CAMBIAR_POR_UN_TOKEN_LARGO

# OpenAI se usa solo desde este backend. Nunca copies esta clave a Flutter.
OPENAI_API_KEY=REEMPLAZAR_SOLO_BACKEND
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=max

ENABLE_SCHEDULER=false
SCHEDULER_RUN_ON_STARTUP=false
MAX_MATCHES_PER_SCHEDULER_CYCLE=5
SCHEDULER_HORIZON_DAYS=7
SCHEDULER_PREDICTION_HORIZON_DAYS=14
SCHEDULER_DAILY_HOUR=0
SCHEDULER_DAILY_MINUTE=5
DEFAULT_TIMEZONE=America/Lima
MODEL_ROOT=./models
TEAM_PROFILE_ROOT=./data/team_profiles
